# SAHI Configuration & Environment Variables
# NEVER commit .env to version control!

# App Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Mock Bank Ledger Configuration
MOCK_BANK_DB_PATH=data/mock_bank.sqlite3
MOCK_BANK_HOST=127.0.0.1
MOCK_BANK_PORT=8000

# SahiGuard Risk Policies
GUARD_MAX_AUTO_EXECUTE_INR=50000
GUARD_HIGH_VALUE_THRESHOLD_INR=25000

# External AI Model Providers (Stage C - Sarvam)
# Local testing uses mocked HTTP transports and DO NOT require external API keys.
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_BASE_URL=https://api.sarvam.ai
CACHE_DIR=.cache
RUN_LIVE_SARVAM_TESTS=0
