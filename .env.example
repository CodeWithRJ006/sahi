# SAHI Configuration & Environment Variables
# NEVER commit .env to version control!

# App Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Mock Bank Ledger Configuration
MOCK_BANK_DB_PATH=data/mock_bank.sqlite3
MOCK_BANK_HOST=127.0.0.1
MOCK_BANK_PORT=8000

# SahiGuard Risk Policies
GUARD_MAX_AUTO_EXECUTE_INR=50000
GUARD_HIGH_VALUE_THRESHOLD_INR=25000

# External AI Model Providers (Optional - For Stage C onwards)
# Local testing and Stage 1 slices DO NOT require external API keys.
SARVAM_API_KEY=your_sarvam_api_key_here
SAARAS_API_KEY=your_saaras_api_key_here
CACHE_DIR=.cache
